# Copiar a deploy/aws/.env y rellenar. NO subir .env al repo.
# Dominio público. Sin dominio propio usa la IP con sslip.io, p. ej. 3-15-20-100.sslip.io
DOMINIO=
# Contraseña de 'sa' (mín. 8 caracteres, mayúsculas, minúsculas, números y símbolo)
SQL_PASSWORD=
# Clave del organizador (mín. 12 caracteres)
ADMIN_KEY=
# Envío del código por correo (SMTP). Si se deja vacío, la app funciona pero no envía correos.
# Gmail: smtp.gmail.com, 587, tu cuenta y una "contraseña de aplicación" de 16 letras.
CORREO_HOST=
CORREO_PUERTO=587
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_REMITENTE=
