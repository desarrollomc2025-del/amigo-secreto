@inherits LayoutComponentBase
@inject EmpresaActual EmpresaActual

<div class="nieve" aria-hidden="true"></div>

<header class="encabezado">
    <a class="marca" href="@(empresa is null ? "" : EmpresaActual.Ruta(empresa))">
        <span class="marca-icono" aria-hidden="true">🎁</span>
        <span>
            <strong>@(empresa?.Nombre ?? "Amigo secreto")</strong>
            <small>@(empresa?.Subtitulo ?? "Intercambio de regalos")</small>
        </span>
    </a>
</header>

@* data-empresa: app.js guarda el código personal por empresa. *@
<main class="contenido" data-empresa="@empresa?.Slug">
    @Body
</main>

<footer class="pie">
    <span aria-hidden="true">🎄</span> ¡Felices fiestas! <span aria-hidden="true">🍰</span>
</footer>

@code {
    private Empresa? empresa;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // /admin no pertenece a ninguna empresa: encabezado genérico.
        if (HttpContext?.Request.Path.StartsWithSegments("/admin") != true)
            empresa = await EmpresaActual.ObtenerAsync();
    }
}
