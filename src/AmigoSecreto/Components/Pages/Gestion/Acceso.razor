@page "/gestion/acceso"
@inject ClaveAdministracion Clave
@inject NavigationManager Navegacion

<PageTitle>Acceso del organizador · Red Cetino-Monteagudo-Rivera</PageTitle>

<section class="tarjeta tarjeta-angosta">
    <h1>🔐 Gestión del intercambio</h1>

    @if (!Clave.Configurada)
    {
        <div class="aviso aviso-error" role="alert">
            La gestión está deshabilitada: falta configurar <code>ADMIN_KEY</code> (mínimo @ClaveAdministracion.LongitudMinima caracteres).
        </div>
    }
    else
    {
        <p class="lead">Ingresa la clave de administración.</p>

        @if (error is not null)
        {
            <div class="aviso aviso-error" role="alert">@error</div>
        }

        <EditForm Model="Form" FormName="acceso" OnValidSubmit="EntrarAsync" class="formulario">
            <DataAnnotationsValidator />
            <div class="campo">
                <label for="clave">Clave</label>
                <InputText id="clave" type="password" @bind-Value="Form.Clave" required autocomplete="current-password" />
                <ValidationMessage For="() => Form.Clave" class="error-campo" />
            </div>
            <button type="submit" class="btn btn-primario btn-bloque">Entrar</button>
        </EditForm>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "acceso")]
    private AccesoForm Form { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "volver")]
    private string? Volver { get; set; }

    private string? error;

    // Solo se vuelve a páginas de gestión conocidas (evita redirecciones abiertas).
    private string Destino => Volver?.TrimEnd('/').ToLowerInvariant() switch
    {
        "/gestion/parejas" => "gestion/parejas",
        _ => "gestion",
    };

    protected override void OnInitialized()
    {
        Form ??= new AccesoForm();
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.IsInRole(Politicas.Organizador))
            Navegacion.NavigateTo(Destino);
    }

    private async Task EntrarAsync()
    {
        if (!Clave.Verificar(Form.Clave))
        {
            error = "La clave no es correcta.";
            return;
        }

        var identidad = new ClaimsIdentity(
            [new Claim(ClaimTypes.Name, "Organizador"), new Claim(ClaimTypes.Role, Politicas.Organizador)],
            CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identidad));
        Navegacion.NavigateTo(Destino);
    }
}
