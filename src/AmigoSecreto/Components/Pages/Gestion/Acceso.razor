@page "/gestion/acceso"
@page "/{EmpresaSlug}/gestion/acceso"
@inherits PaginaEmpresa
@inject ClaveAdministracion ClaveGeneral

<PageTitle>Acceso del organizador · @NombreEmpresa</PageTitle>

@if (Emp is null)
{
    return;
}
<section class="tarjeta tarjeta-angosta">
    <h1>🔐 Gestión del intercambio</h1>

    @if (!ClaveGeneral.Configurada && Emp.ClaveHash is null)
    {
        <div class="aviso aviso-error" role="alert">
            La gestión está deshabilitada: esta empresa no tiene clave de organizador y falta configurar <code>ADMIN_KEY</code>
            (mínimo @ClaveAdministracion.LongitudMinima caracteres).
        </div>
    }
    else
    {
        <p class="lead">Ingresa la clave del organizador de <strong>@Emp.Nombre</strong>.</p>

        @if (error is not null)
        {
            <div class="aviso aviso-error" role="alert">@error</div>
        }

        <EditForm Model="Form" FormName="acceso" OnValidSubmit="EntrarAsync" class="formulario">
            <DataAnnotationsValidator />
            <div class="campo">
                <label for="clave">Clave</label>
                <InputText id="clave" type="password" @bind-Value="Form.Clave" required autocomplete="current-password" />
                <ValidationMessage For="() => Form.Clave" class="error-campo" />
            </div>
            <button type="submit" class="btn btn-primario btn-bloque">Entrar</button>
        </EditForm>
    }
</section>

@code {
    [SupplyParameterFromForm(FormName = "acceso")]
    private AccesoForm Form { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "volver")]
    private string? Volver { get; set; }

    private string? error;

    // Solo se vuelve a páginas de gestión conocidas (evita redirecciones abiertas).
    private string Destino => Ruta(Volver?.Trim('/').ToLowerInvariant() switch
    {
        "gestion/parejas" => "gestion/parejas",
        "gestion/reporte" => "gestion/reporte",
        _ => "gestion",
    });

    protected override async Task OnInitializedAsync()
    {
        Form ??= new AccesoForm();
        if (!await CargarEmpresaAsync()) return;
        if (HttpMethods.IsGet(HttpContext.Request.Method) && Politicas.PuedeGestionar(HttpContext.User, Emp!.Id))
            Navegacion.NavigateTo(Destino);
    }

    private async Task EntrarAsync()
    {
        if (Emp is null) return;

        // ADMIN_KEY entra a cualquier empresa (y a /admin); la clave de la empresa, solo a esta.
        List<Claim> claims;
        if (ClaveGeneral.Verificar(Form.Clave))
            claims = [new(ClaimTypes.Name, "Administrador"), new(ClaimTypes.Role, Politicas.Administrador)];
        else if (HashClave.Verificar(Form.Clave, Emp.ClaveHash))
            claims = [new(ClaimTypes.Name, "Organizador"), new(ClaimTypes.Role, Politicas.Organizador),
                      new(Politicas.ClaimEmpresa, Emp.Id.ToString())];
        else
        {
            error = "La clave no es correcta.";
            return;
        }

        var identidad = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identidad));
        Navegacion.NavigateTo(Destino);
    }
}
